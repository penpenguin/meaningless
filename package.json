{
  "name": "aquarium-web-app",
  "version": "1.0.0",
  "description": "Realistic aquarium web application with Three.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "generate:fish-assets": "node scripts/generate-fish-assets.mjs",
    "measure:performance": "node scripts/measure-aquarium-performance.mjs",
    "screenshot": "node scripts/capture-aquarium-screenshot.mjs",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "verify:soc": "depcruise --config .dependency-cruiser.cjs --include-only '^src' --output-type err --progress none src"
  },
  "dependencies": {
    "three": "^0.184.0",
    "tweakpane": "^4.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.1",
    "@types/three": "^0.184.1",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "dependency-cruiser": "^17.4.3",
    "eslint": "^10.4.1",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.58.2",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vite-plugin-glsl": "^1.5.4",
    "vitest": "^4.0.10"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/penpenguin/meaningless.git"
  }
}
